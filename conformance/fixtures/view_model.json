            "description": "Get a user by ID",
            "tags": [
              "users"
            ],
            "display": {
              "alias": "get-user",
              "description": null,
              "documentation": null,
              "guidance": null,
              "tags": null,
              "cli": {},
              "mcp": {},
              "a2a": {}
            }
          },
          {
            "module_id": "orders.list_orders",
            "description": "List all orders",
            "tags": [
              "orders"
            ],
            "display": null
          }
        ],
        "options": {
          "view": "list",
          "columns": [
            "module_id",
            "alias",
            "description",
            "tags"
          ]
        }
      },
      "expected": "{\"schema_version\":1,\"kind\":\"list\",\"columns\":[{\"key\":\"module_id\",\"label\":\"ID\"},{\"key\":\"alias\",\"label\":\"Alias\"},{\"key\":\"description\",\"label\":\"Description\"},{\"key\":\"tags\",\"label\":\"Tags\"}],\"rows\":[{\"cells\":[{\"kind\":\"text\",\"value\":\"users.get_user\"},{\"kind\":\"text\",\"value\":\"get-user\"},{\"kind\":\"text\",\"value\":\"Get a user by ID\"},{\"kind\":\"tags\",\"values\":[\"users\"]}],\"tags\":[\"users\"]},{\"cells\":[{\"kind\":\"text\",\"value\":\"orders.list_orders\"},{\"kind\":\"text\",\"value\":\"orders.list_orders\"},{\"kind\":\"text\",\"value\":\"List all orders\"},{\"kind\":\"tags\",\"values\":[\"orders\"]}],\"tags\":[\"orders\"]}]}"
    }
