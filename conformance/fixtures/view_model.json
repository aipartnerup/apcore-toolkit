    {
      "id": "view_model_010_tone_palette_deprecated_warning",
      "description": "tag_equals rule emits warning tone",
      "input": {
        "modules": [
          {
            "module_id": "a.one",
            "description": "A one",
            "tags": [
              "users",
              "deprecated"
            ]
          },
          {
            "module_id": "a.two",
            "description": "A two",
            "tags": [
              "users",
              "read-only"
            ]
          }
        ],
        "options": {
          "view": "list",
          "columns": [
            "module_id",
            "description",
            "tags"
          ],
          "tone_palettes": [
            {
              "name": "tag_palette",
              "rules": [
                {
                  "kind": "tag_equals",
                  "value": "deprecated",
                  "tone": "warning"
                },
                {
                  "kind": "tag_equals",
                  "value": "read-only",
                  "tone": "info"
                }
              ]
            }
          ]
        }
      },
      "expected": "{\"schema_version\":1,\"kind\":\"list\",\"columns\":[{\"key\":\"module_id\",\"label\":\"ID\"},{\"key\":\"description\",\"label\":\"Description\"},{\"key\":\"tags\",\"label\":\"Tags\",\"tone_by\":\"tag_palette\"}],\"rows\":[{\"cells\":[{\"kind\":\"text\",\"value\":\"a.one\"},{\"kind\":\"text\",\"value\":\"A one\"},{\"kind\":\"tags\",\"values\":[\"users\",\"deprecated\"]}],\"tags\":[\"users\",\"deprecated\"]},{\"cells\":[{\"kind\":\"text\",\"value\":\"a.two\"},{\"kind\":\"text\",\"value\":\"A two\"},{\"kind\":\"tags\",\"values\":[\"users\",\"read-only\"]}],\"tags\":[\"users\",\"read-only\"]}],\"tone_palettes\":[{\"name\":\"tag_palette\",\"rules\":[{\"match\":{\"kind\":\"tag_equals\",\"value\":\"deprecated\"},\"tone\":\"warning\"},{\"match\":{\"kind\":\"tag_equals\",\"value\":\"read-only\"},\"tone\":\"info\"}]}]}"
    },
    {
      "id": "view_model_011_display_overlay_alias",
